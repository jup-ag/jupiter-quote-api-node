{
  "name": "@jup-ag/api",
  "version": "6.0.48",
  "description": "Jupiter API client",
  "homepage": "https://github.com/jup-ag/jupiter-quote-api-node",
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/jup-ag/jupiter-quote-api-node.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "typings": "dist/index.d.ts",
  "scripts": {
    "build": "bun run generate && tsdown",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "prepare-openapi": "bun run scripts/prepare-openapi.ts",
    "openapi-gen": "openapi-generator-cli generate -i openapi/jupiter.yaml -o generated -g typescript-fetch --skip-validate-spec",
    "generate": "rm -rf generated && bun run prepare-openapi && bun run openapi-gen",
    "prepare": "husky"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.40.1",
    "@types/bun": "^1.3.14",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  }
}
